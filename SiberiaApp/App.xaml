<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="SiberiaApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Estilos de Windows 11 (los mismos que usa WinUI Gallery) -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ==========================================================
                 ESTILOS PROPIOS DE LA APP
                 Si cambias algo aqui, se cambia en TODAS las pantallas.
                 ========================================================== -->

            <!-- "Tarjeta": el recuadro con fondo y esquinas redondeadas
                 que agrupa cada seccion (como en la configuracion de Windows 11) -->
            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>

            <!-- Texto de los encabezados de columna de las tablas -->
            <Style x:Key="EncabezadoColumna" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Fila de encabezados de las tablas (arriba de cada ListView) -->
            <Style x:Key="FilaEncabezado" TargetType="Grid">
                <Setter Property="Padding" Value="16,8,12,8" />
                <Setter Property="ColumnSpacing" Value="12" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
            </Style>

            <!-- Texto de las celdas de las tablas -->
            <Style x:Key="TextoCelda" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- Titulo de cada tarjeta ("Datos del cliente", "Ticket", etc.) -->
            <Style x:Key="TituloTarjeta" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- ===== Estilos para tarjetas de indicadores (panel de administracion y reportes) ===== -->
            <Style x:Key="TarjetaIndicador" TargetType="Border" BasedOn="{StaticResource Tarjeta}">
                <Setter Property="MinWidth" Value="200" />
                <Setter Property="Padding" Value="18,14" />
            </Style>

            <Style x:Key="EtiquetaIndicador" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="ValorIndicador" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,4,0,2" />
            </Style>

            <Style x:Key="NotaIndicador" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Titulo grande de cada pantalla -->
            <Style x:Key="TituloPagina" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- Caja de texto del ticket (letra monoespaciada como recibo) -->
            <Style x:Key="CajaTicket" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
