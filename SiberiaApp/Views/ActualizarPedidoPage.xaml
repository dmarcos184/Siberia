<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiberiaApp.Views.ActualizarPedidoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiberiaApp.Models"
    xmlns:helpers="using:SiberiaApp.Helpers"
    NavigationCacheMode="Required">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="160" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="barraAviso" Grid.Row="0" IsOpen="False" />

        <TextBlock Grid.Row="1"
                   Text="Selecciona un pedido de la lista y define su nuevo estado:"
                   Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- ===== Tabla de pedidos ===== -->
        <Border Grid.Row="2" Style="{StaticResource Tarjeta}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource FilaEncabezado}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="130" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folio" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="1" Text="Cliente" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="2" Text="Atendió" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="3" Text="Fecha" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="4" Text="Total" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="5" Text="Estado" Style="{StaticResource EncabezadoColumna}" />
                </Grid>

                <ListView x:Name="dgvActualizar" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="DgvActualizar_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FilaPedido">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="130" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Folio}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Cliente}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Usuario}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Fecha}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Total}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Estado}" Style="{StaticResource TextoCelda}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind helpers:Vista.ColorEstado(Estado)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ===== Detalle (con notas) y cambio de estado ===== -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                <StackPanel>
                    <TextBlock Text="Detalle del pedido" Style="{StaticResource TituloTarjeta}" />
                    <TextBox x:Name="txtDetalle"
                             Style="{StaticResource CajaTicket}"
                             Height="190"
                             PlaceholderText="Selecciona un pedido para ver sus productos y notas" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="lblFolioSeleccionado"
                               Text="Pedido seleccionado: (ninguno)"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextWrapping="Wrap" />

                    <ComboBox x:Name="cmbNuevoEstado"
                              Header="Nuevo estado" HorizontalAlignment="Stretch">
                        <x:String>Pendiente</x:String>
                        <x:String>En preparacion</x:String>
                        <x:String>Entregado</x:String>
                        <x:String>Cancelado</x:String>
                    </ComboBox>

                    <!-- Explica por que no se puede modificar (otro usuario, ya finalizado, corte cerrado) -->
                    <TextBlock x:Name="lblMotivoBloqueo"
                               Style="{StaticResource NotaIndicador}"
                               Visibility="Collapsed" />

                    <Button x:Name="btnActualizarEstado"
                            Content="Actualizar estado del pedido"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Click="BtnActualizarEstado_Click" />

                    <!-- Solo administrador: dinero devuelto al cliente de un pedido entregado -->
                    <StackPanel x:Name="panelDevolucion" Spacing="8" Visibility="Collapsed">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />
                        <TextBlock Text="Devolución al cliente" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="lblDevuelto" Style="{StaticResource NotaIndicador}" />
                        <NumberBox x:Name="txtMontoDevolucion"
                                   Header="Monto a devolver ($)"
                                   Minimum="0" Value="0"
                                   SpinButtonPlacementMode="Hidden" />
                        <TextBox x:Name="txtMotivoDevolucion"
                                 Header="Motivo"
                                 PlaceholderText="Ej. producto en mal estado"
                                 MaxLength="200" />
                        <Button x:Name="btnRegistrarDevolucion"
                                Content="Registrar devolución"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False"
                                Click="BtnRegistrarDevolucion_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
