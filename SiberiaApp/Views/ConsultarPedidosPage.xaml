<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiberiaApp.Views.ConsultarPedidosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiberiaApp.Models"
    xmlns:helpers="using:SiberiaApp.Helpers"
    NavigationCacheMode="Required">

    <Grid Padding="24,0,24,24" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="420" />
            <ColumnDefinition Width="2*" MinWidth="340" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="barraAviso" Grid.Row="0" Grid.ColumnSpan="2" IsOpen="False" />

        <!-- ===== Filtros ===== -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="txtBuscarPedido"
                     Width="240"
                     Header="Buscar"
                     PlaceholderText="Cliente o folio"
                     KeyDown="TxtBuscarPedido_KeyDown" />
            <CalendarDatePicker x:Name="dtpDesde" Header="Desde" PlaceholderText="Sin límite"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
            <CalendarDatePicker x:Name="dtpHasta" Header="Hasta" PlaceholderText="Sin límite"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
            <!-- Solo para administradores: ver los pedidos de cualquier usuario -->
            <ComboBox x:Name="cmbUsuarioFiltro" Header="Usuario" Width="170"
                      DisplayMemberPath="Nombre" Visibility="Collapsed" />
            <Button x:Name="btnBuscar" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnBuscar_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <SymbolIcon Symbol="Find" />
                    <TextBlock Text="Buscar" />
                </StackPanel>
            </Button>
            <Button x:Name="btnMostrarTodos" VerticalAlignment="Bottom"
                    Content="Mostrar todos"
                    Click="BtnMostrarTodos_Click" />
        </StackPanel>

        <!-- ===== Tabla de pedidos ===== -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Style="{StaticResource FilaEncabezado}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Folio" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="1" Text="Cliente" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="2" Text="Atendió" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="3" Text="Fecha" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="4" Text="Total" Style="{StaticResource EncabezadoColumna}" />
                    <TextBlock Grid.Column="5" Text="Estado" Style="{StaticResource EncabezadoColumna}" />
                </Grid>

                <ListView x:Name="dgvPedidos" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="DgvPedidos_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:FilaPedido">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind Folio}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Cliente}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Usuario}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="3" Text="{x:Bind Fecha}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="4" Text="{x:Bind Total}" Style="{StaticResource TextoCelda}" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Estado}" Style="{StaticResource TextoCelda}"
                                           FontWeight="SemiBold"
                                           Foreground="{x:Bind helpers:Vista.ColorEstado(Estado)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ===== Detalle / ticket (incluye las notas de cada producto) ===== -->
        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Tarjeta}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Detalle del pedido / ticket" Style="{StaticResource TituloTarjeta}" />
                <TextBox x:Name="txtDetallePedido" Grid.Row="1"
                         Style="{StaticResource CajaTicket}"
                         PlaceholderText="Selecciona un pedido de la lista" />

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="btnGuardarTicketTxt" Click="BtnGuardarTicketTxt_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Download" />
                            <TextBlock Text="Guardar ticket (.txt)" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnAbrirCarpetaTickets"
                            Content="Abrir carpeta"
                            Click="BtnAbrirCarpetaTickets_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
