<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiberiaApp.Views.ReportesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiberiaApp.Models"
    xmlns:services="using:SiberiaApp.Services"
    xmlns:helpers="using:SiberiaApp.Helpers"
    NavigationCacheMode="Required">

    <Grid Padding="24,0,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="barraAviso" Grid.Row="0" IsOpen="False" />

        <!-- ===== Filtros ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="cmbPeriodo" Header="Periodo" Width="150"
                      SelectionChanged="CmbPeriodo_SelectionChanged">
                <x:String>Día</x:String>
                <x:String>Semana</x:String>
                <x:String>Mes</x:String>
                <x:String>Personalizado</x:String>
            </ComboBox>
            <CalendarDatePicker x:Name="dtpReporte"
                                Header="Fecha de referencia"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
            <CalendarDatePicker x:Name="dtpHasta" Header="Hasta" Visibility="Collapsed"
                                DateFormat="{}{day.integer(2)}/{month.integer(2)}/{year.full}" />
            <ComboBox x:Name="cmbUsuarioFiltro" Header="Usuario" Width="170"
                      DisplayMemberPath="Nombre" Visibility="Collapsed" />
            <Button x:Name="btnGenerar" VerticalAlignment="Bottom"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="BtnGenerar_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing x:Name="anilloCarga" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                    <TextBlock Text="Generar reporte" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="lblTituloReporte"
                       VerticalAlignment="Bottom" Margin="12,0,0,6"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- ===== Indicadores ===== -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="colUtilidad" Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock Text="TOTAL VENDIDO" Style="{StaticResource EtiquetaIndicador}" />
                    <TextBlock x:Name="lblTotalReporte" Text="$0.00" Style="{StaticResource ValorIndicador}" />
                    <TextBlock x:Name="lblVariacion" Style="{StaticResource NotaIndicador}" />
                    <TextBlock x:Name="lblMetodos" Style="{StaticResource NotaIndicador}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock Text="PEDIDOS" Style="{StaticResource EtiquetaIndicador}" />
                    <TextBlock x:Name="lblCantidadPedidosReporte" Text="0" Style="{StaticResource ValorIndicador}" />
                    <TextBlock x:Name="lblCancelados" Style="{StaticResource NotaIndicador}" />
                    <TextBlock x:Name="lblAjustes" Style="{StaticResource NotaIndicador}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource TarjetaIndicador}">
                <StackPanel>
                    <TextBlock Text="TICKET PROMEDIO" Style="{StaticResource EtiquetaIndicador}" />
                    <TextBlock x:Name="lblPromedio" Text="$0.00" Style="{StaticResource ValorIndicador}" />
                    <TextBlock Text="Venta promedio por pedido" Style="{StaticResource NotaIndicador}" />
                </StackPanel>
            </Border>

            <!-- Solo administrador: los costos y la ganancia no se muestran a usuarios normales -->
            <Border x:Name="tarjetaUtilidad" Grid.Column="3" Style="{StaticResource TarjetaIndicador}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="GANANCIA (VENTAS - COSTO)" Style="{StaticResource EtiquetaIndicador}" />
                    <TextBlock x:Name="lblUtilidad" Text="—" Style="{StaticResource ValorIndicador}" />
                    <TextBlock x:Name="lblNotaUtilidad" Style="{StaticResource NotaIndicador}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Tabla y productos mas vendidos ===== -->
        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Tarjeta}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Style="{StaticResource FilaEncabezado}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Folio" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="1" Text="Cliente" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="2" Text="Atendió" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="3" Text="Fecha" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="4" Text="Productos (con notas)" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="5" Text="Total" Style="{StaticResource EncabezadoColumna}" />
                        <TextBlock Grid.Column="6" Text="Estado" Style="{StaticResource EncabezadoColumna}" />
                    </Grid>

                    <ListView x:Name="dgvReporte" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:FilaPedido">
                                <Grid ColumnSpacing="12" Padding="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Folio}" Style="{StaticResource TextoCelda}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cliente}" Style="{StaticResource TextoCelda}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Usuario}" Style="{StaticResource TextoCelda}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Fecha}" Style="{StaticResource TextoCelda}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Productos}" Style="{StaticResource TextoCelda}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind Total}" Style="{StaticResource TextoCelda}" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind Estado}" Style="{StaticResource TextoCelda}"
                                               FontWeight="SemiBold"
                                               Foreground="{x:Bind helpers:Vista.ColorEstado(Estado)}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Más vendidos" Style="{StaticResource TituloTarjeta}" Margin="0" />
                    <ListView x:Name="lstTopProductos" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:ProductoVendido">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Nombre}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource EtiquetaIndicador}">
                                            <Run Text="{x:Bind Cantidad}" /><Run Text=" vendidos" />
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind helpers:Formato.Dinero(Importe)}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
