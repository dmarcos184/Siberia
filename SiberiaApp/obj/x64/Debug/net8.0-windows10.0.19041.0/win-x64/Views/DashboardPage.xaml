<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiberiaApp.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiberiaApp.Models"
    xmlns:services="using:SiberiaApp.Services"
    xmlns:helpers="using:SiberiaApp.Helpers">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24,0,24,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Encabezado ===== -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Resumen del negocio" Style="{StaticResource TituloPagina}" />
                    <TextBlock x:ConnectionId='33' x:Name="txtActualizado"
                               Style="{StaticResource NotaIndicador}"
                               Text="Cargando datos..." />
                </StackPanel>
                <ProgressRing x:ConnectionId='31' x:Name="anilloCarga" Grid.Column="1" Width="24" Height="24" IsActive="False" />
                <Button x:ConnectionId='32' x:Name="btnActualizar" Grid.Column="2"                            >
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="Refresh" />
                        <TextBlock Text="Actualizar" />
                    </StackPanel>
                </Button>
            </Grid>

            <InfoBar x:ConnectionId='2' x:Name="barraAviso" Grid.Row="1" IsOpen="False" />

            <!-- ===== Ventas: hoy / semana / mes ===== -->
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="VENTAS DE HOY" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='27' x:Name="txtVentasHoy" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock x:ConnectionId='28' x:Name="txtPedidosHoy" Style="{StaticResource NotaIndicador}" />
                        <TextBlock x:ConnectionId='29' x:Name="txtVarHoy" Style="{StaticResource NotaIndicador}" />
                        <TextBlock x:ConnectionId='30' x:Name="txtMetodosHoy" Style="{StaticResource NotaIndicador}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="VENTAS DE LA SEMANA" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='24' x:Name="txtVentasSemana" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock x:ConnectionId='25' x:Name="txtPedidosSemana" Style="{StaticResource NotaIndicador}" />
                        <TextBlock x:ConnectionId='26' x:Name="txtVarSemana" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="VENTAS DEL MES" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='21' x:Name="txtVentasMes" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock x:ConnectionId='22' x:Name="txtPedidosMes" Style="{StaticResource NotaIndicador}" />
                        <TextBlock x:ConnectionId='23' x:Name="txtVarMes" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Ganancias y estado de la operacion ===== -->
            <Grid Grid.Row="3" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="GANANCIA DEL MES (VENTAS - COSTO)" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='19' x:Name="txtUtilidadMes" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock x:ConnectionId='20' x:Name="txtNotaUtilidad" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="PEDIDOS EN CURSO" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='18' x:Name="txtEnCurso" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock Text="Pendientes o en preparación" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="CORTES PENDIENTES" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='17' x:Name="txtCortesPendientes" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock Text="Días anteriores sin cerrar" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource TarjetaIndicador}">
                    <StackPanel>
                        <TextBlock Text="USUARIOS ACTIVOS" Style="{StaticResource EtiquetaIndicador}" />
                        <TextBlock x:ConnectionId='16' x:Name="txtUsuariosActivos" Text="—" Style="{StaticResource ValorIndicador}" />
                        <TextBlock Text="Cuentas que pueden entrar" Style="{StaticResource NotaIndicador}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Grafica y productos mas vendidos ===== -->
            <Grid Grid.Row="4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Ventas de los últimos 7 días" Style="{StaticResource TituloTarjeta}" />
                        <ItemsControl x:ConnectionId='10' x:Name="graficaSemana">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Height="200" Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate                                 >
                                    <StackPanel x:ConnectionId='12' Width="64" VerticalAlignment="Bottom" Spacing="4">
                                        <TextBlock x:ConnectionId='13'                      
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   HorizontalAlignment="Center" />
                                        <Border x:ConnectionId='14'                         
                                                CornerRadius="4,4,0,0"
                                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock x:ConnectionId='15'                         
                                                   Style="{StaticResource EtiquetaIndicador}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Tarjeta}">
                    <StackPanel>
                        <TextBlock Text="Más vendidos del mes" Style="{StaticResource TituloTarjeta}" />
                        <TextBlock x:ConnectionId='3' x:Name="txtSinProductos"
                                   Text="Todavía no hay ventas este mes."
                                   Style="{StaticResource NotaIndicador}"
                                   Visibility="Collapsed" />
                        <ListView x:ConnectionId='4' x:Name="lstTopProductos" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate                                      >
                                    <Grid x:ConnectionId='6' ColumnSpacing="12" Padding="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock x:ConnectionId='8'                        Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource EtiquetaIndicador}">
                                                <Run x:ConnectionId='9'                          /><Run Text=" vendidos" />
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock x:ConnectionId='7' Grid.Column="1"                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

