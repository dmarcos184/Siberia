<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SiberiaApp.Views.NuevaOrdenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiberiaApp.Models"
    xmlns:helpers="using:SiberiaApp.Helpers"
    NavigationCacheMode="Required">
    <!-- NavigationCacheMode="Required": si te cambias de pantalla y regresas,
         el pedido que estabas capturando sigue ahi -->

    <Grid Padding="24,0,24,24" ColumnSpacing="16" RowSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="400" />
            <ColumnDefinition Width="2*" MinWidth="380" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:ConnectionId='2' x:Name="barraAviso" Grid.Row="0" Grid.ColumnSpan="2" IsOpen="False" />

        <!-- ===== Datos del cliente ===== -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Tarjeta}">
            <StackPanel Spacing="12">
                <TextBlock Text="Cliente" Style="{StaticResource TituloTarjeta}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:ConnectionId='42' x:Name="txtCliente" Grid.Column="0"
                             Header="Nombre" PlaceholderText="Nombre del cliente" MaxLength="60" />
                    <ComboBox x:ConnectionId='43' x:Name="cmbTipoPedido" Grid.Column="1"
                              Header="Tipo de pedido" HorizontalAlignment="Stretch"
                                                                               >
                        <x:String>Mostrador</x:String>
                        <x:String>Domicilio</x:String>
                    </ComboBox>
                </Grid>

                <!-- Solo se ve cuando el pedido es a domicilio -->
                <Grid x:ConnectionId='39' x:Name="panelDomicilio" ColumnSpacing="12" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:ConnectionId='40' x:Name="txtDireccion" Grid.Column="0"
                             Header="Dirección" PlaceholderText="Calle, número, colonia" MaxLength="120" />
                    <TextBox x:ConnectionId='41' x:Name="txtTelefono" Grid.Column="1"
                             Header="Teléfono" PlaceholderText="10 dígitos" MaxLength="20" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Catalogo de productos: un toque agrega una unidad ===== -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Tarjeta}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="200" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Productos" Style="{StaticResource TituloTarjeta}"
                               VerticalAlignment="Center" Margin="0" />
                    <TextBox x:ConnectionId='37' x:Name="txtBuscarProducto" Grid.Column="1"
                             PlaceholderText="Buscar producto..."
                                                                         />
                    <ComboBox x:ConnectionId='38' x:Name="cmbCategoria" Grid.Column="2"
                              HorizontalAlignment="Stretch"
                                                                               />
                </Grid>

                <GridView x:ConnectionId='31' x:Name="gridProductos" Grid.Row="1"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                                                             >
                    <GridView.ItemTemplate>
                        <DataTemplate                             >
                            <Border x:ConnectionId='33' Style="{StaticResource Tarjeta}" Width="170" MinHeight="86" Padding="12">
                                <StackPanel Spacing="2">
                                    <TextBlock x:ConnectionId='34'                       
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" MaxLines="2" />
                                    <TextBlock x:ConnectionId='35'                           Style="{StaticResource EtiquetaIndicador}" />
                                    <TextBlock x:ConnectionId='36'                                               
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Border>

        <!-- ===== Pedido actual (carrito) ===== -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Style="{StaticResource Tarjeta}">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="Pedido actual" Style="{StaticResource TituloTarjeta}" Margin="0" />
                    <TextBlock x:ConnectionId='30' x:Name="lblArticulos" Text="0 productos"
                               Style="{StaticResource EtiquetaIndicador}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:ConnectionId='3' x:Name="lblVacio" Grid.Row="1"
                           Text="Toca un producto del catálogo para agregarlo."
                           Style="{StaticResource NotaIndicador}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <ListView x:ConnectionId='4' x:Name="lstOrden" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate                                  >
                            <Grid x:ConnectionId='20' ColumnSpacing="8" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Nombre, precio y NOTAS (siempre visibles) -->
                                <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2">
                                    <TextBlock x:ConnectionId='27'                               
                                               Style="{StaticResource BodyStrongTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource EtiquetaIndicador}">
                                        <Run x:ConnectionId='29'                                                        /><Run Text=" c/u" />
                                    </TextBlock>
                                    <TextBlock x:ConnectionId='28'                             
                                                                                                               
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                               TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Cantidad -->
                                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Top">
                                    <Button x:ConnectionId='24' Content="−" Width="32" Padding="0,2"                                       />
                                    <TextBlock x:ConnectionId='25'                          Width="24" TextAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <Button x:ConnectionId='26' Content="+" Width="32" Padding="0,2"                                     />
                                </StackPanel>

                                <TextBlock x:ConnectionId='21' Grid.Column="2" Grid.Row="0"
                                                                                           
                                           TextAlignment="Right" VerticalAlignment="Center" />

                                <!-- Acciones del renglon -->
                                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1"
                                            Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button x:ConnectionId='22'                                      >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Comment" />
                                            <TextBlock Text="Notas" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:ConnectionId='23'                                       >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock Text="Quitar" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Pago, descuento y total -->
                <StackPanel Grid.Row="2" Spacing="8" Margin="0,4,0,0">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:ConnectionId='17' x:Name="cmbMetodoPago" Grid.Column="0"
                                  Header="Método de pago" HorizontalAlignment="Stretch" SelectedIndex="0">
                            <x:String>Efectivo</x:String>
                            <x:String>Tarjeta</x:String>
                            <x:String>Transferencia</x:String>
                        </ComboBox>
                        <NumberBox x:ConnectionId='18' x:Name="txtDescuento" Grid.Column="1"
                                   Header="Descuento ($)"
                                   Minimum="0" Value="0"
                                   SpinButtonPlacementMode="Hidden"
                                                                            />
                    </Grid>

                    <Grid>
                        <TextBlock Text="Subtotal" Style="{StaticResource EtiquetaIndicador}" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='16' x:Name="lblSubtotalOrden" Text="$0.00" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:ConnectionId='13' x:Name="filaDescuento" Visibility="Collapsed">
                        <TextBlock Text="Descuento" Style="{StaticResource EtiquetaIndicador}" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='15' x:Name="lblDescuentoOrden" Text="-$0.00" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="TOTAL" Style="{StaticResource EtiquetaIndicador}" VerticalAlignment="Center" />
                        <TextBlock x:ConnectionId='14' x:Name="lblTotalOrden" Text="$0.00"
                                   Style="{StaticResource TitleTextBlockStyle}"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:ConnectionId='9' x:Name="btnLimpiarOrden" Grid.Column="0"
                            Content="Limpiar"                               />
                    <Button x:ConnectionId='10' x:Name="btnGuardarPedido" Grid.Column="1"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch"
                                                          >
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <ProgressRing x:ConnectionId='11' x:Name="anilloGuardando" Width="16" Height="16" IsActive="False" Visibility="Collapsed" />
                            <SymbolIcon x:ConnectionId='12' x:Name="iconoGuardar" Symbol="Save" />
                            <TextBlock Text="Confirmar y guardar pedido" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Ticket del ultimo pedido guardado -->
                <Expander x:ConnectionId='5' x:Name="expTicket" Grid.Row="4" Header="Último ticket"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBox x:ConnectionId='6' x:Name="txtTicketPreview"
                                 Style="{StaticResource CajaTicket}"
                                 Height="220"
                                 PlaceholderText="Aquí aparece el ticket al guardar el pedido" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:ConnectionId='7' x:Name="btnGuardarTicketTxt"                                  >
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Download" />
                                    <TextBlock Text="Guardar ticket (.txt)" />
                                </StackPanel>
                            </Button>
                            <Button x:ConnectionId='8' x:Name="btnAbrirCarpetaTickets"
                                    Content="Abrir carpeta"
                                                                         />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </Grid>
        </Border>
    </Grid>
</Page>

